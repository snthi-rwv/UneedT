// Esquema de base de datos de UneedT (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum TaskSource {
  MANUAL
  EMAIL
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SurveyKind {
  BASELINE
  FOLLOWUP
}

enum AccountStatus {
  ACTIVE
  REVOKED
}

// Intensidad del plan de estudio: define la duración de los bloques y de los descansos
enum PlanIntensity {
  LIGHT // bloques de 25 min, descansos de 5
  NORMAL // bloques de 45 min, descansos de 10
  INTENSE // bloques de 60 min, descansos de 10
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String? // null si el usuario solo entra con Google
  googleId     String?  @unique
  createdAt    DateTime @default(now())

  aiPrioritizedAt DateTime? // última repriorización automática con IA (como máximo una cada 6 horas)

  subjects      Subject[]
  tasks         Task[]
  refreshTokens RefreshToken[]
  emailAccount  EmailAccount?
  syncLogs      EmailSyncLog[]
  proposals     TaskProposal[]
  processed     ProcessedEmail[]
  plans         StudyPlan[]
  surveys       Survey[]
  guides        TaskGuide[]
  studyDays     StudyDay[]
}

// Refresh tokens de UneedT. Se guarda solo el hash (SHA-256), nunca el token.
model RefreshToken {
  id        String    @id // = claim "jti" del JWT
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subject {
  id           String   @id @default(cuid())
  userId       String
  name         String
  difficulty   Int      @default(3) // 1 (fácil) a 5 (muy difícil)
  currentGrade Float? // escala colombiana 0.0 - 5.0
  color        String   @default("#14213D")
  targetGrade  Float    @default(3) // nota final que quiere sacar (se aprueba con 3.0)
  createdAt    DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]
  grades GradeEntry[]

  @@unique([userId, name])
}

model Task {
  id             String     @id @default(cuid())
  userId         String
  subjectId      String?
  title          String
  description    String?
  dueDate        DateTime
  weightPct      Float      @default(10) // % de la nota final
  complexity     Int        @default(3) // 1 a 5
  estimatedHours Float      @default(2)
  hoursSpent     Float      @default(0)
  status         TaskStatus @default(PENDING)
  source         TaskSource @default(MANUAL)
  priorityScore  Float      @default(0)
  priorityReason String     @default("")
  aiAdjustment   Float      @default(0) // ajuste de la IA (-10 a 10) que se suma al puntaje de la fórmula
  aiReason       String? // motivo que dio la IA; mientras exista, reemplaza al de la fórmula
  critical       Boolean    @default(false)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  blocks  StudyBlock[]
  guide   TaskGuide?

  @@index([userId, status, priorityScore])
  @@index([userId, dueDate])
}

// Cuenta de Gmail conectada (OAuth solo lectura). El refresh token va cifrado (AES-256-GCM).
model EmailAccount {
  id              String        @id @default(cuid())
  userId          String        @unique
  email           String
  refreshTokenEnc String
  status          AccountStatus @default(ACTIVE)
  lastSyncAt      DateTime?
  createdAt       DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailSyncLog {
  id         String    @id @default(cuid())
  userId     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  fetched    Int       @default(0)
  proposed   Int       @default(0)
  error      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// Correos ya leídos, para no volver a procesarlos
model ProcessedEmail {
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
}

// Panel de confirmación humana: la IA propone, el estudiante decide
model TaskProposal {
  id             String         @id @default(cuid())
  userId         String
  messageId      String
  fromAddress    String
  emailSubject   String
  snippet        String
  subjectHint    String?
  title          String
  description    String?
  dueDate        DateTime?
  weightPct      Float?
  complexity     Int?
  estimatedHours Float?
  confidence     Float
  status         ProposalStatus @default(PENDING)
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, title])
  @@index([userId, status])
}

model StudyPlan {
  id             String        @id @default(cuid())
  userId         String
  date           String // AAAA-MM-DD
  availableHours Float
  startTime      String        @default("08:00") // HH:mm
  endTime        String        @default("") // HH:mm en que termina el plan (con descansos); sirve para replantearlo
  intensity      PlanIntensity @default(NORMAL)
  createdAt      DateTime      @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks StudyBlock[]

  @@unique([userId, date])
}

model StudyBlock {
  id        String  @id @default(cuid())
  planId    String
  taskId    String
  order     Int
  startTime String // HH:mm
  minutes   Int
  note      String  @default("")
  done      Boolean @default(false)

  plan StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  task Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// Indicador de Fin: puntuación de agobio académico (1-5)
model Survey {
  id            String     @id @default(cuid())
  userId        String
  score         Int // agobio (1-5): indicador de la Matriz de Marco Lógico
  concentration Int? // concentración percibida (1-5)
  performance   Int? // rendimiento percibido (1-5)
  kind          SurveyKind
  createdAt     DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Plan específico de una tarea: el contexto que dio el estudiante y el paso a paso de la IA
model TaskGuide {
  id         String   @id @default(cuid())
  taskId     String   @unique
  userId     String
  context    String   @default("") // lo que escribió el estudiante (temas, qué le piden...)
  sourceName String? // nombre del archivo adjunto (rúbrica, correo del profesor...)
  sourceText String? // texto extraído del archivo, recortado. El archivo en sí no se guarda.
  summary    String   @default("") // qué se pide, en una frase (lo escribe la IA)
  usedAi     Boolean  @default(false) // false = pasos genéricos (plan B sin IA)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task  Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps GuideStep[]

  @@index([userId])
}

// Subtarea del plan específico, con su cronómetro
model GuideStep {
  id              String    @id @default(cuid())
  guideId         String
  order           Int
  title           String
  detail          String    @default("")
  minutes         Int // tiempo estimado
  done            Boolean   @default(false)
  doneAt          DateTime?
  spentSeconds    Int       @default(0) // tiempo medido con el cronómetro (tramos ya cerrados)
  runningSince    DateTime? // si el cronómetro está corriendo, desde cuándo
  creditedSeconds Int       @default(0) // lo que este paso ya sumó a las horas dedicadas de la tarea

  guide TaskGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, order])
}

// Notas del semestre en una materia: qué porcentaje se evaluó y qué nota sacó
model GradeEntry {
  id        String   @id @default(cuid())
  subjectId String
  order     Int
  label     String   @default("") // ej.: "Parcial 1" (opcional)
  percent   Float // % de la nota final (0 a 100)
  grade     Float // nota obtenida (0.0 a 5.0)
  createdAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, order])
}

// Tiempo de estudio por día (hora de Colombia): alimenta la racha y el tablero de progreso
model StudyDay {
  userId  String
  date    String // AAAA-MM-DD
  seconds Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}
