# ---------- Servidor ----------
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL="postgresql://postgres:TU_CONTRASEÑA@localhost:5432/uneedt?schema=public"

# ---------- JWT (secretos DISTINTOS y largos) ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Cifrado de tokens de Gmail en la BD (32 bytes en hex) ----------
TOKEN_ENC_KEY=

# ---------- Google OAuth 2.0 (inicio de sesión + lectura de Gmail) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# ---------- IA (la clave vive SOLO aquí, nunca en el frontend) ----------
# Proveedor: groq (gratis, recomendado) | gemini (gratis) | openrouter | anthropic (de pago) | custom
AI_PROVIDER=groq
AI_API_KEY=
# Opcionales: ya traen valores según el proveedor
AI_MODEL=
AI_FALLBACK_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=30000